# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=bottle_spin_bot

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/bottle_spin_bot
# Или для SQLite:
# DATABASE_URL=sqlite:///./bottle_spin_bot.db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Application Settings
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# Game Settings
MAX_PLAYERS_PER_ROOM=8
SPIN_INTERVAL_SECONDS=30
DECISION_TIMEOUT_SECONDS=10
MIN_USER_AGE=18

# Monetization Settings
VIP_MONTHLY_PRICE=99  # in Telegram Stars
VIP_QUARTERLY_PRICE=249
VIP_BIANNUAL_PRICE=449
INITIAL_COINS=100
INITIAL_ENERGY=100
ENERGY_RECOVERY_RATE=1  # per minute

# Payment Settings
PAYMENTS_PROVIDER_TOKEN=your_stripe_key_or_similar
TELEGRAM_PAYMENTS_ENABLED=True

# Admin Settings
ADMIN_USER_IDS=123456789,987654321
SUPPORT_CHAT_ID=-1001234567890

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api/v1

# Security
SECRET_KEY=your_secret_key_here_change_in_production
ALGORITHM=HS256
